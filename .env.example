# PostgreSQL connection string used by Payload.
# From GitHub Actions the build does not need a database. In Dokploy this must
# point at the internal Postgres service, e.g.
# postgresql://user:password@my-project-datbase:5432/weekly
DATABASE_URL=postgresql://payload:payload@127.0.0.1:5432/weekly

# Used to encrypt JWT tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public URL of the site, no trailing slash. Inlined into the client bundle at
# build time, so set it as a Docker build arg too.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Site name displayed in the logo and throughout the site
NEXT_PUBLIC_SITE_NAME=Infotaktik

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_PREVIEW_SECRET_HERE

# Optional: password for the two demo authors created by `pnpm seed:prod`.
# When unset a random password is generated and the accounts can be reset in
# the admin panel.
SEED_AUTHOR_PASSWORD=

# Optional: directory for uploaded media. Defaults to ./public/media.
# Point this at a persistent volume in production.
# MEDIA_DIR=/data/media

# Cloudflare R2 Storage Configuration
# Get these from your Cloudflare R2 dashboard
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# Optional: Public URL for accessing images (e.g., custom domain or R2 public bucket URL)
R2_PUBLIC_URL=https://your-custom-domain.com

# Cloudflare R2 Backup Configuration
# Separate bucket for PostgreSQL database backups
R2_BACKUP_BUCKET_NAME=your_backup_bucket_name
# Optional: Number of backups to retain (default: 7)
R2_BACKUP_RETENTION_DAYS=7
# Optional: Prefix for backup filenames (default: "backup")
BACKUP_PREFIX=backup
