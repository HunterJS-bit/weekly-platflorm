# syntax=docker/dockerfile:1
#
# Production image for the Weekly CMS.
#
# The build is deliberately database-free: all CMS pages are rendered on demand,
# so `next build` never needs production database credentials. Migrations are
# applied automatically by Payload the first time the server connects to the DB
# (see `prodMigrations` in src/payload.config.ts).

FROM node:22.23.4-alpine AS base

RUN apk add --no-cache libc6-compat postgresql-client aws-cli
RUN corepack enable && corepack prepare pnpm@12.16.1 --activate

WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
FROM base AS deps

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
FROM base AS builder

# NEXT_PUBLIC_* values are inlined at build time, so the public URL must be
# provided as a Docker build arg (Dokploy: Build Args, or the Build Command).
ARG NEXT_PUBLIC_SERVER_URL=http://localhost:3000
ENV NEXT_PUBLIC_SERVER_URL=$NEXT_PUBLIC_SERVER_URL

# Placeholders only. The build does not connect to a database; real values are
# supplied at runtime by Dokploy. Keeping them set avoids config validation
# errors while still failing loudly if build-time DB access ever creeps back in.
ENV DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build
ENV PAYLOAD_SECRET=build-only-secret-not-used-at-runtime

COPY --from=deps /app/node_modules ./node_modules
COPY . .

RUN pnpm run build

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM base AS runner

ENV NODE_ENV=production
ENV PORT=4005
ENV HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs

# `public` includes the seed images and generated sitemap files. The media
# directory must stay writable for uploads made through the CMS.
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/scripts ./scripts

RUN mkdir -p /app/public/media && chown -R nextjs:nodejs /app/public/media

USER nextjs

EXPOSE 4005

# server.js is generated by `output: 'standalone'`.
CMD ["node", "server.js"]
